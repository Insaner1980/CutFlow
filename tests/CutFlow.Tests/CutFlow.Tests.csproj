<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)CutFlow.Tests.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.3.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/CutFlow/CutFlow.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="SerializationFixtures\schema-1-legacy-minimal.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="TestMedia\valid-audio.wav" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="TestMedia\valid-image.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="TestMedia\valid-video.mp4" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateX64Configuration" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Platform)' != 'x64'" Text="CutFlow tests support only the x64 platform. Set Platform=x64." />
    <Error Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'win-x64'" Text="CutFlow tests support only the win-x64 runtime identifier." />
  </Target>
</Project>
