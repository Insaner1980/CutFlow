<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="WindowBackgroundColor">#FF0D0E10</Color>
            <Color x:Key="TitleBarBackgroundColor">#FF141518</Color>
            <Color x:Key="SurfaceColor">#FF1A1C20</Color>
            <Color x:Key="SurfaceElevatedColor">#FF22252A</Color>
            <Color x:Key="SurfaceHoverColor">#FF272A30</Color>
            <Color x:Key="ControlBackgroundColor">#FF2A2D33</Color>
            <Color x:Key="BorderColor">#FF343840</Color>
            <Color x:Key="TextPrimaryColor">#FFF2F4F7</Color>
            <Color x:Key="TextSecondaryColor">#FFA8AEB8</Color>
            <Color x:Key="TextTertiaryColor">#FF737A86</Color>
            <Color x:Key="AccentColor">#FF21CFA6</Color>
            <Color x:Key="AccentHoverColor">#FF3CDDB9</Color>
            <Color x:Key="AccentPressedColor">#FF18B991</Color>
            <Color x:Key="AccentTextColor">#FF0D0E10</Color>
            <Color x:Key="ErrorColor">#FFFF656D</Color>
            <Color x:Key="WarningColor">#FFF3B95F</Color>
            <Color x:Key="SelectionColor">#3321CFA6</Color>
            <Color x:Key="PreviewBackgroundColor">#FF050506</Color>
            <Color x:Key="ChromeBackgroundColor">#FF111215</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="WindowBackgroundColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="TitleBarBackgroundColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="SurfaceColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="SurfaceElevatedColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="SurfaceHoverColor" ResourceKey="SystemColorButtonFaceColor" />
            <StaticResource x:Key="ControlBackgroundColor" ResourceKey="SystemColorButtonFaceColor" />
            <StaticResource x:Key="BorderColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="TextPrimaryColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="TextSecondaryColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="TextTertiaryColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="AccentColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="AccentHoverColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="AccentPressedColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="AccentTextColor" ResourceKey="SystemColorHighlightTextColor" />
            <StaticResource x:Key="ErrorColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="WarningColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="SelectionColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="PreviewBackgroundColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="ChromeBackgroundColor" ResourceKey="SystemColorWindowColor" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{ThemeResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{ThemeResource TitleBarBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{ThemeResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{ThemeResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{ThemeResource ControlBackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{ThemeResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{ThemeResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="{ThemeResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{ThemeResource AccentTextColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{ThemeResource AccentHoverColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{ThemeResource ErrorColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource WarningColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{ThemeResource SelectionColor}" />
    <SolidColorBrush x:Key="PreviewBackgroundBrush" Color="{ThemeResource PreviewBackgroundColor}" />
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="{ThemeResource ChromeBackgroundColor}" />

    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <x:Double x:Key="CompactSpacing">8</x:Double>
    <x:Double x:Key="SectionSpacing">16</x:Double>
    <x:Double x:Key="TimelineCardHorizontalPadding">7</x:Double>
    <x:Double x:Key="TimelineCardVerticalPadding">3</x:Double>
    <x:Double x:Key="TimelineCardTitleFontSize">11</x:Double>
    <x:Double x:Key="TimelineCardDetailFontSize">9</x:Double>
    <x:Double x:Key="TimelineCardCornerRadius">4</x:Double>

    <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="HeadingTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SectionTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="CutFlowButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource FocusBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource WindowBackgroundBrush}" />
    </Style>
    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource FocusBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource WindowBackgroundBrush}" />
    </Style>
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource CutFlowButtonStyle}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="RailButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="62" />
        <Setter Property="MinHeight" Value="54" />
        <Setter Property="Padding" Value="4,6" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource FocusBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource WindowBackgroundBrush}" />
    </Style>
</ResourceDictionary>
