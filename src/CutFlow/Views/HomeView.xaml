<UserControl
    x:Class="CutFlow.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:CutFlow.ViewModels"
    Loaded="HomeView_Loaded">
    <Grid x:Name="HomeRoot" Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource TitleBarBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="9">
                <Viewbox Width="20" Height="20">
                    <Canvas Width="24" Height="24">
                        <Path Fill="{StaticResource AccentBrush}" Data="M3,4 L10,4 L21,12 L10,20 L3,20 L14,12 Z" />
                        <Path Fill="{StaticResource AccentMutedBrush}" Data="M10,8 L15,12 L10,16 L7,16 L12,12 L7,8 Z" />
                    </Canvas>
                </Viewbox>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.ProductName, Mode=OneWay}" />
            </StackPanel>
            <Grid x:Name="TitleBarDragRegion" Grid.Column="1" Background="Transparent" />
        </Grid>

        <NavigationView
            x:Name="HomeNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="208"
            PaneDisplayMode="Left"
            SelectionChanged="HomeNavigation_SelectionChanged">
            <NavigationView.PaneFooter>
                <Button
                    Margin="12,8,12,16"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Create new project"
                    Click="NewProject_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    TabIndex="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="New project" />
                    </StackPanel>
                </Button>
            </NavigationView.PaneFooter>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem" Content="Home" Icon="Home" Tag="home" AutomationProperties.Name="Home" TabIndex="0" />
                <NavigationViewItem Content="Projects" Icon="Library" Tag="projects" AutomationProperties.Name="Projects" TabIndex="1" />
                <NavigationViewItem Content="Settings" Icon="Setting" Tag="settings" AutomationProperties.Name="Settings" TabIndex="2" />
            </NavigationView.MenuItems>

            <Grid>
                <InfoBar
                    x:Name="OperationError"
                    Margin="24,16,24,0"
                    VerticalAlignment="Top"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Error"
                    Title="Project operation failed" />

                <ScrollViewer x:Name="ProjectsState" Padding="32,28,32,36" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="22">
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="ProjectsHeading" Style="{StaticResource HeadingTextBlockStyle}" Text="Recent projects" />
                                <TextBlock Margin="0,5,0,0" Style="{StaticResource BodyTextBlockStyle}" Text="Continue a local edit or start with a clean timeline." />
                            </StackPanel>
                            <ProgressRing x:Name="BusyIndicator" HorizontalAlignment="Right" VerticalAlignment="Center" Width="24" Height="24" IsActive="False" />
                        </Grid>

                        <Border x:Name="EmptyProjects" Padding="40" MinHeight="250" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                <FontIcon HorizontalAlignment="Center" FontSize="36" Foreground="{StaticResource TextTertiaryBrush}" Glyph="&#xE8B7;" />
                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource SectionTitleTextBlockStyle}" Text="No projects yet" />
                                <TextBlock MaxWidth="360" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" Text="Create a project to open the editor. Projects and imported-media references stay on this device." />
                                <Button Margin="0,8,0,0" AutomationProperties.Name="Create first project" Click="NewProject_Click" Style="{StaticResource AccentButtonStyle}" Content="Create project" />
                            </StackPanel>
                        </Border>

                        <ItemsRepeater x:Name="ProjectRepeater" ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="260" MinColumnSpacing="16" MinRowSpacing="16" ItemsStretch="None" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProjectCardViewModel">
                                    <Border Width="260" MinHeight="224" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="140" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Button
                                                Grid.RowSpan="2"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                AutomationProperties.Name="{x:Bind OpenAutomationName, Mode=OneWay}"
                                                Click="ProjectOpen_Click"
                                                Tag="{x:Bind Id}">
                                                <Grid />
                                                <ToolTipService.ToolTip>
                                                    <ToolTip Content="{x:Bind OpenAutomationName, Mode=OneWay}" />
                                                </ToolTipService.ToolTip>
                                            </Button>
                                            <Grid Margin="8" Background="{StaticResource PreviewBackgroundBrush}" IsHitTestVisible="False">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                                    <FontIcon Foreground="{StaticResource TextTertiaryBrush}" FontSize="28" Glyph="&#xE714;" AutomationProperties.AccessibilityView="Raw" />
                                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Thumbnail unavailable" AutomationProperties.AccessibilityView="Raw" />
                                                </StackPanel>
                                                <Image Source="{x:Bind ThumbnailSource, Mode=OneWay}" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" />
                                            </Grid>
                                            <Grid Grid.Row="1" Padding="12,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3" IsHitTestVisible="False">
                                                    <TextBlock MaxWidth="195" TextTrimming="CharacterEllipsis" Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind Name}" AutomationProperties.AccessibilityView="Raw" />
                                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ModifiedText}" AutomationProperties.AccessibilityView="Raw" />
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind AspectRatioText}" AutomationProperties.AccessibilityView="Raw" />
                                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind DurationText}" AutomationProperties.AccessibilityView="Raw" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    Width="40"
                                                    Height="40"
                                                    VerticalAlignment="Top"
                                                    AutomationProperties.Name="{x:Bind ActionsAutomationName}"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Tag="{x:Bind Id}">
                                                    <FontIcon FontSize="15" Glyph="&#xE712;" AutomationProperties.AccessibilityView="Raw" />
                                                    <ToolTipService.ToolTip>
                                                        <ToolTip Content="{x:Bind ActionsAutomationName}" />
                                                    </ToolTipService.ToolTip>
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Open" AutomationProperties.Name="{x:Bind OpenActionName}" Tag="{x:Bind Id}" Click="ProjectOpenMenu_Click" />
                                                            <MenuFlyoutItem Text="Rename" AutomationProperties.Name="{x:Bind RenameActionName}" Tag="{x:Bind Id}" Click="RenameProject_Click" />
                                                            <MenuFlyoutItem Text="Duplicate" AutomationProperties.Name="{x:Bind DuplicateActionName}" Tag="{x:Bind Id}" Click="DuplicateProject_Click" />
                                                            <MenuFlyoutSeparator />
                                                            <MenuFlyoutItem Text="Delete" AutomationProperties.Name="{x:Bind DeleteActionName}" Tag="{x:Bind Id}" Click="DeleteProject_Click" />
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsState" Visibility="Collapsed" Padding="32,28">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left" Spacing="18">
                        <TextBlock Style="{StaticResource HeadingTextBlockStyle}" Text="Settings" />
                        <Border Padding="20" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}" Text="Local prototype preferences" />
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind ViewModel.LocalSettingsDescription, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="No account, cloud sync, telemetry, or online library is included." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</UserControl>
