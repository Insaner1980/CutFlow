<UserControl
    x:Class="CutFlow.Views.EditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CutFlow.Controls"
    Loaded="EditorView_Loaded"
    Unloaded="EditorView_Unloaded"
    SizeChanged="EditorView_SizeChanged"
    KeyDown="EditorRoot_KeyDown">
    <Grid x:Name="EditorRoot" Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition x:Name="TimelineRow" Height="300" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource TitleBarBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Grid.Column="0" Width="34" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Back to Home" Click="Back_Click" TabIndex="0">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
                <ToolTipService.ToolTip><ToolTip Content="Back to Home" /></ToolTipService.ToolTip>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                        <Path Fill="{StaticResource AccentBrush}" Data="M3,4 L10,4 L21,12 L10,20 L3,20 L14,12 Z" />
                        <Path Fill="{StaticResource AccentMutedBrush}" Data="M10,8 L15,12 L10,16 L7,16 L12,12 L7,8 Z" />
                    </Canvas>
                </Viewbox>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.ProductName, Mode=OneWay}" />
            </StackPanel>
            <Grid Grid.Column="2" Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <TextBox
                        x:Name="ProjectNameBox"
                        MinWidth="96"
                        MaxWidth="300"
                        Padding="4,2"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.ProjectName, Mode=OneWay}"
                        AutomationProperties.Name="Project name"
                        TabIndex="1"
                        KeyDown="ProjectNameBox_KeyDown"
                        LostFocus="ProjectNameBox_LostFocus" />
                    <TextBlock Foreground="{StaticResource TextTertiaryBrush}" Text="•" />
                    <TextBlock x:Name="SaveStatusText" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.SaveStatus, Mode=OneWay}" />
                </StackPanel>
                <Grid x:Name="TitleBarDragRegion" Grid.Column="1" Margin="12,0,0,0" Background="Transparent" />
            </Grid>
            <Button x:Name="UndoButton" Grid.Column="3" Margin="2,0" AutomationProperties.Name="Undo" Click="Undo_Click" IsEnabled="{x:Bind ViewModel.CanUndo, Mode=OneWay}" Style="{StaticResource IconButtonStyle}" TabIndex="2">
                <FontIcon FontSize="14" Glyph="&#xE7A7;" />
                <ToolTipService.ToolTip><ToolTip Content="Undo" /></ToolTipService.ToolTip>
            </Button>
            <Button x:Name="RedoButton" Grid.Column="4" Margin="2,0" AutomationProperties.Name="Redo" Click="Redo_Click" IsEnabled="{x:Bind ViewModel.CanRedo, Mode=OneWay}" Style="{StaticResource IconButtonStyle}" TabIndex="3">
                <FontIcon FontSize="14" Glyph="&#xE7A6;" />
                <ToolTipService.ToolTip><ToolTip Content="Redo" /></ToolTipService.ToolTip>
            </Button>
            <ToggleButton x:Name="InspectorToggleButton" Grid.Column="5" Width="34" Height="32" Margin="6,0,2,0" Padding="0" AutomationProperties.Name="Hide inspector" Click="InspectorToggle_Click" IsChecked="True" TabIndex="4">
                <FontIcon FontSize="14" Glyph="&#xE90D;" />
                <ToolTipService.ToolTip><ToolTip Content="Hide inspector" /></ToolTipService.ToolTip>
            </ToggleButton>
            <Button x:Name="ExportButton" Grid.Column="6" Margin="8,0" AutomationProperties.Name="Export project" Click="Export_Click" Style="{StaticResource AccentButtonStyle}" TabIndex="5">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon FontSize="14" Glyph="&#xE898;" />
                    <TextBlock Text="Export" />
                </StackPanel>
            </Button>
            <Button
                x:Name="ExportAvailabilityButton"
                Grid.Column="7"
                Width="34"
                Height="32"
                Margin="0,0,6,0"
                Padding="0"
                AutomationProperties.Name="Why export is unavailable"
                Click="ExportAvailability_Click"
                Style="{StaticResource IconButtonStyle}"
                TabIndex="6"
                Visibility="Collapsed">
                <FontIcon FontSize="14" Glyph="&#xE946;" />
                <ToolTipService.ToolTip><ToolTip Content="Why export is unavailable" /></ToolTipService.ToolTip>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid x:Name="WorkspaceGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="292" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                    <ColumnDefinition x:Name="InspectorSeparatorColumn" Width="1" />
                    <ColumnDefinition x:Name="InspectorColumn" Width="324" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled" Background="{StaticResource ChromeBackgroundBrush}">
                    <StackPanel>
                        <Button x:Name="MediaToolButton" Tag="Media" Click="Tool_Click" Style="{StaticResource RailButtonStyle}" AutomationProperties.Name="Media" TabIndex="10"><StackPanel Spacing="3"><FontIcon FontSize="17" Glyph="&#xE8B7;" /><TextBlock FontSize="11" Text="Media" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel></Button>
                        <Button x:Name="AudioToolButton" Tag="Audio" Click="Tool_Click" Style="{StaticResource RailButtonStyle}" AutomationProperties.Name="Audio" TabIndex="11"><StackPanel Spacing="3"><FontIcon FontSize="17" Glyph="&#xE8D6;" /><TextBlock FontSize="11" Text="Audio" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel></Button>
                        <Button x:Name="TextToolButton" Tag="Text" Click="Tool_Click" Style="{StaticResource RailButtonStyle}" AutomationProperties.Name="Text" TabIndex="12"><StackPanel Spacing="3"><FontIcon FontSize="17" Glyph="&#xE8D2;" /><TextBlock FontSize="11" Text="Text" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel></Button>
                        <Button x:Name="StickersToolButton" Tag="Stickers" Click="Tool_Click" Style="{StaticResource RailButtonStyle}" AutomationProperties.Name="Stickers" TabIndex="13"><StackPanel Spacing="3"><FontIcon FontSize="17" Glyph="&#xE899;" /><TextBlock FontSize="11" Text="Stickers" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel></Button>
                        <Button x:Name="EffectsToolButton" Tag="Effects" Click="Tool_Click" Style="{StaticResource RailButtonStyle}" AutomationProperties.Name="Effects" TabIndex="14"><StackPanel Spacing="3"><FontIcon FontSize="17" Glyph="&#xE945;" /><TextBlock FontSize="11" Text="Effects" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel></Button>
                        <Button x:Name="TransitionsToolButton" Tag="Transitions" Click="Tool_Click" Style="{StaticResource RailButtonStyle}" AutomationProperties.Name="Transitions" TabIndex="15"><StackPanel Spacing="3"><FontIcon FontSize="17" Glyph="&#xE7C8;" /><TextBlock FontSize="10" Text="Transitions" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel></Button>
                        <Button x:Name="CaptionsToolButton" Tag="Captions" Click="Tool_Click" Style="{StaticResource RailButtonStyle}" AutomationProperties.Name="Captions" TabIndex="16"><StackPanel Spacing="3"><FontIcon FontSize="17" Glyph="&#xE8C1;" /><TextBlock FontSize="11" Text="Captions" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel></Button>
                        <Button x:Name="FiltersToolButton" Tag="Filters" Click="Tool_Click" Style="{StaticResource RailButtonStyle}" AutomationProperties.Name="Filters" TabIndex="17"><StackPanel Spacing="3"><FontIcon FontSize="17" Glyph="&#xE71C;" /><TextBlock FontSize="11" Text="Filters" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel></Button>
                        <Button x:Name="AdjustmentToolButton" Tag="Adjustment" Click="Tool_Click" Style="{StaticResource RailButtonStyle}" AutomationProperties.Name="Adjustment" TabIndex="18"><StackPanel Spacing="3"><FontIcon FontSize="17" Glyph="&#xE9E9;" /><TextBlock FontSize="10" Text="Adjustment" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel></Button>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />
                <controls:MediaPanel x:Name="ToolPanel" Grid.Column="2" ImportRequested="ToolPanel_ImportRequested" AddTextRequested="ToolPanel_AddTextRequested" />
                <Border Grid.Column="3" Background="{StaticResource BorderBrush}" />
                <controls:PreviewPane x:Name="Preview" Grid.Column="4" ImportRequested="Preview_ImportRequested" PlayPauseRequested="Preview_PlayPauseRequested" SeekRequested="Preview_SeekRequested" />
                <Border x:Name="InspectorSeparator" Grid.Column="5" Background="{StaticResource BorderBrush}" />
                <controls:InspectorPanel x:Name="DesktopInspector" Grid.Column="6" EditCommitted="Inspector_EditCommitted" />
            </Grid>

            <InfoBar
                x:Name="EditorInfoBar"
                Canvas.ZIndex="20"
                Margin="12"
                MaxWidth="720"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                IsClosable="True"
                IsOpen="False" />

        </Grid>
        <ContentControl x:Name="TimelineResizeHandle" Grid.Row="2" IsTabStop="True" UseSystemFocusVisuals="True"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="Resize timeline"
                AutomationProperties.HelpText="Use the Up and Down arrow keys to resize the timeline."
                KeyDown="TimelineResizeHandle_KeyDown"
                PointerPressed="TimelineResizeHandle_PointerPressed"
                PointerMoved="TimelineResizeHandle_PointerMoved"
                PointerReleased="TimelineResizeHandle_PointerReleased"
                PointerCanceled="TimelineResizeHandle_PointerCanceled"
                PointerCaptureLost="TimelineResizeHandle_PointerCaptureLost">
            <Grid Background="Transparent">
                <Border Height="1" VerticalAlignment="Center" Background="{StaticResource TextTertiaryBrush}" IsHitTestVisible="False" />
            </Grid>
            <ToolTipService.ToolTip><ToolTip Content="Resize timeline (Up/Down arrows)" /></ToolTipService.ToolTip>
        </ContentControl>
        <controls:TimelineControl
            x:Name="Timeline"
            Grid.Row="3"
            AssetDropped="Timeline_AssetDropped"
            DropRejected="Timeline_DropRejected"
            EditRequested="Timeline_EditRequested"
            MediaFilesDropped="Timeline_MediaFilesDropped"
            PlayheadChanged="Timeline_PlayheadChanged"
            SelectionChanged="Timeline_SelectionChanged"
            TrackStateChanged="Timeline_TrackStateChanged" />
        <Border x:Name="InspectorOverlay" Grid.Row="1" Grid.RowSpan="3" Canvas.ZIndex="10" Width="324" HorizontalAlignment="Right" Visibility="Collapsed" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <controls:InspectorPanel x:Name="NarrowInspector" EditCommitted="Inspector_EditCommitted" />
                <Button Width="30" Height="30" Margin="0,8,8,0" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="Close inspector" Click="CloseOverlayInspector_Click" Style="{StaticResource IconButtonStyle}" TabIndex="51">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                    <ToolTipService.ToolTip><ToolTip Content="Close inspector" /></ToolTipService.ToolTip>
                </Button>
            </Grid>
        </Border>
        <Border
            x:Name="ExportStatusPanel"
            Grid.Row="1"
            Grid.RowSpan="3"
            Canvas.ZIndex="30"
            Width="380"
            Margin="16"
            Padding="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="{StaticResource SurfaceElevatedBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Visibility="Collapsed">
            <StackPanel Spacing="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ExportStatusTitle" Style="{StaticResource SectionTitleTextBlockStyle}" Text="Exporting video" />
                    <Button x:Name="DismissExportStatusButton" Grid.Column="1" AutomationProperties.Name="Dismiss export status" Click="DismissExportStatus_Click" Style="{StaticResource IconButtonStyle}" Visibility="Collapsed">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                        <ToolTipService.ToolTip><ToolTip Content="Dismiss export status" /></ToolTipService.ToolTip>
                    </Button>
                </Grid>
                <TextBlock x:Name="ExportStatusMessage" AutomationProperties.LiveSetting="Polite" Style="{StaticResource BodyTextBlockStyle}" />
                <ProgressBar x:Name="ExportProgressBar" Minimum="0" Maximum="100" Value="0" />
                <Grid x:Name="ExportProgressActions">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ExportProgressText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="0%" />
                    <Button x:Name="CancelExportButton" Grid.Column="1" AutomationProperties.Name="Cancel export" Click="CancelExport_Click" Content="Cancel" Style="{StaticResource CutFlowButtonStyle}" />
                </Grid>
                <StackPanel x:Name="ExportSuccessActions" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <Button AutomationProperties.Name="Open exported file" Click="OpenExportedFile_Click" Content="Open file" Style="{StaticResource AccentButtonStyle}" />
                    <Button AutomationProperties.Name="Open export folder" Click="OpenExportFolder_Click" Content="Open folder" Style="{StaticResource CutFlowButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
